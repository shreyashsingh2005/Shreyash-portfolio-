            </motion.div>
            
            <AnimatedTitle text="SHREYASH.DEV" />
            
            <motion.h2 
              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 1.5, duration: 0.8 }}
              style={{ fontSize: 'clamp(1.5rem, 3vw, 2.5rem)', fontWeight: 300, marginBottom: '2rem', maxWidth: '800px', margin: '0 auto 2rem' }}
            >
              Engineering <span className="text-fire" style={{ fontWeight: 700 }}>Unconventional</span> Web Experiences.
            </motion.h2>
            
